# macOS
.DS_Store

# Obsidian（共有したい設定のみ追跡する）
.obsidian/workspace*.json
.obsidian/cache
.obsidian/plugins/*/data.json
.trash/

# 著作権上、公開リポジトリに含められない原本は raw/private/ に置く
raw/private/

# Claude Code のエージェント用 worktree（.claude/ の共有設定は追跡できるよう、worktree のみ除外する）
/.claude/worktrees/

# 静的サイトのビルド用に取得する Quartz 本体と成果物
/site/.quartz/
